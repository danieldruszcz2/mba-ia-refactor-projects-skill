{
  "info": {
    "name": "Ecommerce API Legacy (Frankenstein LMS)",
    "description": "Todas as operações da ecommerce-api-legacy. Suba a API com `npm start` (porta 3000). O banco é SQLite em memória: reiniciar a API restaura os dados seed (usuário 1 = Leonan, cursos 1 = Clean Architecture R$997 e 2 = Docker R$497).\n\nRegras do checkout: cartão começando com '4' é aprovado; qualquer outro é recusado. Campos obrigatórios: usr, eml (email válido), c_id (inteiro), card (12–19 dígitos); pwd é opcional.\n\nRotas administrativas (relatório financeiro e deleção de usuário) ficam desligadas por padrão e respondem 403. Para usá-las, suba a API com `ENABLE_ADMIN_ROUTES=true ADMIN_TOKEN=troque-me npm start` e ajuste a variável `adminToken` desta collection para o mesmo valor; ela é enviada no header `X-Admin-Token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "enrollmentId", "value": "" },
    { "key": "userId", "value": "1" },
    { "key": "adminToken", "value": "troque-me" }
  ],
  "item": [
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Checkout - sucesso (novo usuário)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "pm.collectionVariables.set('randomEmail', `user_${Date.now()}@teste.com`);"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('msg = Sucesso', () => pm.expect(body.msg).to.eql('Sucesso'));",
                "pm.test('Retorna enrollment_id', () => pm.expect(body.enrollment_id).to.be.a('number'));",
                "pm.collectionVariables.set('enrollmentId', body.enrollment_id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"Guilherme\",\n  \"eml\": \"{{randomEmail}}\",\n  \"pwd\": \"senhaforte\",\n  \"c_id\": 2,\n  \"card\": \"4111222233334444\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
          }
        },
        {
          "name": "Checkout - sucesso (usuário existente)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('msg = Sucesso', () => pm.expect(pm.response.json().msg).to.eql('Sucesso'));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"Leonan\",\n  \"eml\": \"leonan@fullcycle.com.br\",\n  \"c_id\": 2,\n  \"card\": \"4000111122223333\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
          }
        },
        {
          "name": "Checkout - sem senha (gera senha aleatória)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "pm.collectionVariables.set('randomEmail2', `nopwd_${Date.now()}@teste.com`);"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"Maria\",\n  \"eml\": \"{{randomEmail2}}\",\n  \"c_id\": 1,\n  \"card\": \"4111222233334444\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
          }
        },
        {
          "name": "Checkout - pagamento recusado",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 400', () => pm.response.to.have.status(400));",
                "pm.test('Mensagem de recusa', () => pm.expect(pm.response.text()).to.include('Pagamento recusado'));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"João\",\n  \"eml\": \"joao@teste.com\",\n  \"pwd\": \"123\",\n  \"c_id\": 1,\n  \"card\": \"5111222233334444\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
          }
        },
        {
          "name": "Checkout - campos obrigatórios ausentes",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 400', () => pm.response.to.have.status(400));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"Sem Email\",\n  \"c_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
          }
        },
        {
          "name": "Checkout - curso inexistente",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 404', () => pm.response.to.have.status(404));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"Ana\",\n  \"eml\": \"ana@teste.com\",\n  \"c_id\": 999,\n  \"card\": \"4111222233334444\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Relatório financeiro",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('Retorna array', () => pm.expect(body).to.be.an('array'));",
                "pm.test('Itens têm course/revenue/students', () => body.forEach(c => pm.expect(c).to.have.all.keys('course', 'revenue', 'students')));"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/financial-report", "host": ["{{baseUrl}}"], "path": ["api", "admin", "financial-report"] }
          }
        },
        {
          "name": "Relatório financeiro - sem token (403)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 403', () => pm.response.to.have.status(403));"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/financial-report", "host": ["{{baseUrl}}"], "path": ["api", "admin", "financial-report"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Deletar usuário",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));"
              ] }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
          }
        }
      ]
    }
  ]
}
