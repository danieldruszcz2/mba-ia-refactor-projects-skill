# Porta HTTP (default: 3000)
PORT=3000

# Caminho do banco SQLite (default: :memory: — recriado com seed a cada boot)
DATABASE_PATH=:memory:

# Chave do gateway de pagamento (nunca versione o valor real)
PAYMENT_GATEWAY_KEY=

# Rotas administrativas (GET /api/admin/financial-report, DELETE /api/users/:id)
# Desligadas por padrão: respondem 403. Quando ligadas, exigem o header X-Admin-Token.
ENABLE_ADMIN_ROUTES=false
ADMIN_TOKEN=

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
