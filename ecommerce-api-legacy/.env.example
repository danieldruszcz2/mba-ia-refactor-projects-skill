# Porta HTTP (default: 3000)
PORT=3000
# Caminho do banco SQLite (default: :memory:, recriado e populado a cada boot)
DB_PATH=:memory:
# Chave do gateway de pagamento (nunca commitar o valor real)
PAYMENT_GATEWAY_KEY=
# Rotas administrativas (/api/admin/*, DELETE /api/users/:id). Desligadas por padrão (respondem 403)
ENABLE_ADMIN_ROUTES=false
# Token exigido em "Authorization: Bearer <token>" quando ENABLE_ADMIN_ROUTES=true
ADMIN_TOKEN=
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
