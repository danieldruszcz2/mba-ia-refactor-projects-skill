@baseUrl = http://localhost:3000
@adminToken = troque-me

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo (requer ENABLE_ADMIN_ROUTES=true e ADMIN_TOKEN)
GET {{baseUrl}}/api/admin/financial-report
X-Admin-Token: {{adminToken}}

### Deletar usuário (requer ENABLE_ADMIN_ROUTES=true e ADMIN_TOKEN)
DELETE {{baseUrl}}/api/users/1
X-Admin-Token: {{adminToken}}
