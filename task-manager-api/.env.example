# Copie para .env e ajuste. Nunca versione o .env com valores reais.

# Chave para assinar os tokens de login. Obrigatória em produção
# (sem ela, uma chave aleatória é gerada a cada boot).
SECRET_KEY=

# Banco de dados (default: SQLite em instance/tasks.db)
DATABASE_URL=sqlite:///tasks.db

# Servidor
DEBUG=false
HOST=127.0.0.1
PORT=5000

# Origens CORS permitidas, separadas por vírgula (vazio = nenhuma)
CORS_ORIGINS=

# Habilita operações administrativas (exigem token de usuário admin)
ENABLE_ADMIN_ROUTES=false
TOKEN_MAX_AGE_SECONDS=3600

LOG_LEVEL=INFO
