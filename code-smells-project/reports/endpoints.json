[
  {"name": "index", "method": "GET", "path": "/"},
  {"name": "health", "method": "GET", "path": "/health"},
  {"name": "list-produtos", "method": "GET", "path": "/produtos"},
  {"name": "busca-produtos", "method": "GET", "path": "/produtos/busca?q=mouse&categoria=informatica&preco_min=10&preco_max=500"},
  {"name": "busca-produtos-preco-invalido", "method": "GET", "path": "/produtos/busca?preco_min=abc"},
  {"name": "get-produto-seed", "method": "GET", "path": "/produtos/1"},
  {"name": "get-produto-404", "method": "GET", "path": "/produtos/9999"},
  {"name": "list-usuarios", "method": "GET", "path": "/usuarios"},
  {"name": "get-usuario-seed", "method": "GET", "path": "/usuarios/1"},
  {"name": "get-usuario-404", "method": "GET", "path": "/usuarios/9999"},
  {"name": "list-pedidos", "method": "GET", "path": "/pedidos"},
  {"name": "relatorio-vendas", "method": "GET", "path": "/relatorios/vendas"},

  {"name": "create-produto", "method": "POST", "path": "/produtos",
   "body": {"nome": "Smoke Notebook", "descricao": "Notebook i7 16GB", "preco": 4999.90, "estoque": 5, "categoria": "informatica"},
   "capture": {"produto_id": "dados.id"}},
  {"name": "create-produto-invalido", "method": "POST", "path": "/produtos", "body": {"descricao": "sem nome, preco e estoque"}},
  {"name": "create-produto-preco-texto", "method": "POST", "path": "/produtos", "body": {"nome": "X Produto", "preco": "abc", "estoque": 1}},
  {"name": "create-usuario", "method": "POST", "path": "/usuarios",
   "body": {"nome": "Carlos Teste", "email": "carlos.smoke@email.com", "senha": "senha123"},
   "capture": {"usuario_id": "dados.id"}},
  {"name": "create-usuario-invalido", "method": "POST", "path": "/usuarios", "body": {"nome": "Sem email"}},
  {"name": "login-admin", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com", "senha": "admin123"}},
  {"name": "login-novo-usuario", "method": "POST", "path": "/login", "body": {"email": "carlos.smoke@email.com", "senha": "senha123"}},
  {"name": "login-senha-errada", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com", "senha": "errada"}},
  {"name": "login-sqli", "method": "POST", "path": "/login", "body": {"email": "admin@loja.com' --", "senha": "x"}},
  {"name": "create-pedido", "method": "POST", "path": "/pedidos",
   "body": {"usuario_id": "{{usuario_id}}", "itens": [{"produto_id": 2, "quantidade": 2}, {"produto_id": 3, "quantidade": 1}]},
   "capture": {"pedido_id": "dados.pedido_id"}},
  {"name": "create-pedido-sem-estoque", "method": "POST", "path": "/pedidos",
   "body": {"usuario_id": "{{usuario_id}}", "itens": [{"produto_id": 2, "quantidade": 99999}]}},
  {"name": "create-pedido-sem-itens", "method": "POST", "path": "/pedidos", "body": {"usuario_id": "{{usuario_id}}", "itens": []}},
  {"name": "create-pedido-item-invalido", "method": "POST", "path": "/pedidos", "body": {"usuario_id": "{{usuario_id}}", "itens": [{"quantidade": 1}]}},

  {"name": "get-produto-criado", "method": "GET", "path": "/produtos/{{produto_id}}"},
  {"name": "get-usuario-criado", "method": "GET", "path": "/usuarios/{{usuario_id}}"},
  {"name": "list-pedidos-depois", "method": "GET", "path": "/pedidos"},
  {"name": "list-pedidos-usuario", "method": "GET", "path": "/pedidos/usuario/{{usuario_id}}"},
  {"name": "relatorio-vendas-depois", "method": "GET", "path": "/relatorios/vendas"},

  {"name": "update-produto", "method": "PUT", "path": "/produtos/{{produto_id}}",
   "body": {"nome": "Smoke Notebook Atualizado", "descricao": "Notebook i7 32GB", "preco": 5499.90, "estoque": 3, "categoria": "informatica"}},
  {"name": "update-produto-404", "method": "PUT", "path": "/produtos/9999",
   "body": {"nome": "Nada", "preco": 1, "estoque": 1}},
  {"name": "update-status-pedido", "method": "PUT", "path": "/pedidos/{{pedido_id}}/status", "body": {"status": "enviado"}},
  {"name": "update-status-invalido", "method": "PUT", "path": "/pedidos/{{pedido_id}}/status", "body": {"status": "xyz"}},

  {"name": "admin-query", "method": "POST", "path": "/admin/query", "body": {"sql": "SELECT id, nome FROM produtos"}},
  {"name": "admin-reset-db", "method": "POST", "path": "/admin/reset-db", "skip": "destrutivo: apaga todas as tabelas"},

  {"name": "delete-produto", "method": "DELETE", "path": "/produtos/{{produto_id}}"},
  {"name": "delete-produto-404", "method": "DELETE", "path": "/produtos/{{produto_id}}"}
]
