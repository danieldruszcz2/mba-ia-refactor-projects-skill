# Copie para .env (não versionado) ou exporte no ambiente. Não coloque valores reais neste arquivo.

# Chave de assinatura do Flask. Sem valor, uma chave aleatória é gerada a cada boot (apenas dev).
SECRET_KEY=

# Modo debug do Flask/Werkzeug. Nunca habilite em produção.
DEBUG=false

# Interface e porta do servidor (use 0.0.0.0 apenas atrás de um proxy/containers).
HOST=127.0.0.1
PORT=5000

# Caminho do banco SQLite (relativo à raiz do projeto ou absoluto).
DATABASE_PATH=loja.db

# Origens permitidas para CORS, separadas por vírgula. Vazio = CORS desabilitado.
CORS_ORIGINS=

# Rotas /admin/* (reset do banco e consulta SQL somente leitura). Desabilitadas → 403.
ENABLE_ADMIN_ROUTES=false
# Token exigido no header X-Admin-Token quando as rotas admin estão habilitadas.
ADMIN_TOKEN=

# Nível de log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
