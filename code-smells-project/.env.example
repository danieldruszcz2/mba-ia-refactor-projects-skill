# Copie para .env (não versionado) ou exporte no ambiente. Não coloque valores reais neste arquivo.

# Chave de assinatura de sessão do Flask. Obrigatória em produção.
SECRET_KEY=

# Servidor
DEBUG=false
HOST=127.0.0.1
PORT=5000
APP_ENV=producao
LOG_LEVEL=INFO

# Caminho do arquivo SQLite (default: loja.db na raiz do projeto)
DATABASE_PATH=

# Origens permitidas no CORS, separadas por vírgula (default: *)
CORS_ORIGINS=*

# Rotas /admin/* (reset do banco e consulta SQL somente leitura).
# Desligadas por padrão: respondem 403. Quando ligadas, exigem o header X-Admin-Token.
ENABLE_ADMIN_ROUTES=false
ADMIN_TOKEN=
